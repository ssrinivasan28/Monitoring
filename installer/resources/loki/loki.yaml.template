# Loki Configuration Template
# Generated by Island Pacific Monitoring Suite Installer
# Placeholders will be replaced during installation

auth_enabled: false

server:
  http_listen_port: {{LOKI_PORT}}
  grpc_listen_port: 9096

common:
  instance_addr: 127.0.0.1
  path_prefix: {{DATA_DIR}}
  storage:
    filesystem:
      chunks_directory: {{DATA_DIR}}/chunks
      rules_directory: {{DATA_DIR}}/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 100

schema_config:
  configs:
    - from: 2020-10-24
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

ruler:
  alertmanager_url: http://localhost:9093

limits_config:
  reject_old_samples: true
  reject_old_samples_max_age: 9480h
  retention_period: 9480h
  ingestion_rate_mb: 16
  ingestion_burst_size_mb: 24
  max_streams_per_user: 10000
  max_line_size: 256kb

compactor:
  working_directory: {{DATA_DIR}}/compactor
  retention_enabled: true

table_manager:
  retention_deletes_enabled: true
  retention_period: 9480h

# Analytics disabled
analytics:
  reporting_enabled: false
